# Generate secrets with: openssl rand -hex 32
SESSION_SECRET=
FILE_MASTER_KEY=
REGISTRY_ADDRESS=
CHAIN_ID=968
RPC_URL=https://rpc.bohr.life
WEB_ORIGIN=http://localhost:5173
# Local only by default. Listen wider only behind a proxy
HOST=127.0.0.1
# Set true only behind a reverse proxy you run that sets x-forwarded-for
TRUST_PROXY=false
# Optional: without this the agent stays off and requests go straight to staff
ANTHROPIC_API_KEY=
# Optional: daily audit anchoring
ANCHOR_ADDRESS=
ANCHOR_PRIVATE_KEY=

# Optional: without this the API sends no email and everything else keeps working.
# The sending domain must be verified in Resend first.
RESEND_API_KEY=
MAIL_FROM=Legitfy <hello@legitfy.dev>
MAIL_REPLY_TO=support@legitfy.dev
