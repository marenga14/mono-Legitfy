# Copy to .env beside compose.yaml (never commit).
# docker compose reads this, and the API container gets the same values.
# Generate each secret separately with: openssl rand -hex 32
SESSION_SECRET=
FILE_MASTER_KEY=
# Hex only, because this goes inside a connection URL
POSTGRES_PASSWORD=

# The site's exact address. Browsers calling from anywhere else are blocked.
WEB_ORIGIN=https://www.legitfy.dev

# Use 968 and https://rpc.bohr.life for testnet
CHAIN_ID=677
RPC_URL=https://rpc.botchain.ai
EXPLORER_URL=https://scan.botchain.ai
# The API won't start until this is set
REGISTRY_ADDRESS=

# Optional: without this the agent stays off. Setting it spends money per document.
ANTHROPIC_API_KEY=
# Optional: daily audit anchoring. This wallet must own the AuditAnchor contract.
ANCHOR_ADDRESS=
ANCHOR_PRIVATE_KEY=

# Optional: without this the API sends no email and everything else keeps working.
# The sending domain must be verified in Resend first.
RESEND_API_KEY=
MAIL_FROM=Legitfy <hello@legitfy.dev>
MAIL_REPLY_TO=support@legitfy.dev
